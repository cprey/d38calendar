<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title or (calendar_id ~ ' (' ~ start ~ ' to ' ~ end ~ ')') }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  /* Matches the Race Schedule styling on amad38.com (styles.css: base, .race-section, .race-table) */
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: Arial, Helvetica, sans-serif; line-height: 1.6; color: #222; background: #f7f7f7; padding: 20px; }
  a { color: #0044cc; text-decoration: none; }
  a:hover { text-decoration: underline; }

  .race-section { margin: 50px auto; max-width: 1100px; }
  .race-section h2 { text-align: center; margin-bottom: 15px; font-size: 2rem; color: #222; }
  .race-section p.center { text-align: center; margin-bottom: 20px; }

  .race-table { width: 100%; border-collapse: collapse; background: white; border-radius: 6px; overflow: hidden; margin-bottom: 20px; }
  .race-table th { background: #000081; color: white; padding: 12px; font-size: 1rem; text-align: left; }
  .race-table td { padding: 10px; border-bottom: 1px solid #ddd; font-size: 0.95rem; }
  .race-table tr:nth-child(even) { background: #f0f4ff; }
  .race-table td.race-name a { font-weight: bold; }

  /* Additions for this generator: calendar switcher and footer note */
  nav.calendars { text-align: center; margin-bottom: 20px; }
  nav.calendars a, nav.calendars strong { margin: 0 0.25rem; }
  nav.calendars .sep { color: #999; }
  .notes { font-size: 0.9rem; color: #444; text-align: center; }

  @media (max-width: 600px) {
    .race-table th, .race-table td { font-size: 0.85rem; padding: 8px; }
  }
</style>
</head>
<body>
<section class="race-section">
  <h2>{{ title or (calendar_id ~ ' (' ~ start ~ ' to ' ~ end ~ ')') }}</h2>
  {% if nav and nav|length > 1 %}
  <nav class="calendars center">
    {% for item in nav %}{% if not loop.first %}<span class="sep">|</span>{% endif %}{% if item.current %}<strong>{{ item.label }}</strong>{% else %}<a href="{{ item.page }}">{{ item.label }}</a>{% endif %}
    {% endfor %}
  </nav>
  {% endif %}
  <table class="race-table">
    <thead>
      <tr><th>Date</th><th>Race Name</th><th>Club</th><th>Location</th><th>Format</th></tr>
    </thead>
    <tbody>
      {% for event in events %}
      <tr>
        <td>{{ event.start|date('%b')|upper }} {{ event.start.day }}</td>
        <td class="race-name">{% if event.pdf_url %}<a href="{{ event.pdf_url }}" target="_blank" rel="noopener">{{ event.summary }}</a>{% else %}{{ event.summary }}{% endif %}</td>
        <td>{{ event.details.club }}</td>
        {# Label: "Venue:" line, else the location field. Map target: "GPS:" line, else the location field. #}
        {% set venue_label = event.details.venue or event.location %}
        {% set map_query = event.details.gps or event.location %}
        <td>{% if map_query %}<a href="https://www.google.com/maps/search/?api=1&query={{ map_query|urlencode }}" target="_blank" rel="noopener">{{ venue_label or map_query }}</a>{% else %}{{ venue_label }}{% endif %}</td>
        <td>{{ event.details.format }}</td>
      </tr>
      {% else %}
      <tr><td colspan="5">No events in this date range.</td></tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="notes">Updated {{ generated_at.strftime('%Y-%m-%d %H:%M') }}</p>
</section>
</body>
</html>
