<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title or (calendar_id ~ ' (' ~ start ~ ' to ' ~ end ~ ')') }}</title>
<style>
  body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; }
  h1 { font-size: 1.4rem; }
  table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
  th, td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #ddd; vertical-align: top; }
  th { background: #f5f5f5; }
  tr:hover td { background: #fafafa; }
  .meta { color: #666; font-size: 0.9rem; }
  nav.calendars { margin: 0.5rem 0 1rem; font-size: 1rem; }
  nav.calendars a, nav.calendars strong { margin-right: 0.25rem; }
  nav.calendars .sep { color: #999; margin-right: 0.25rem; }
</style>
</head>
<body>
  <h1>{{ title or (calendar_id ~ ' (' ~ start ~ ' to ' ~ end ~ ')') }}</h1>
  {% if nav and nav|length > 1 %}
  <nav class="calendars">
    {% for item in nav %}{% if not loop.first %}<span class="sep">|</span>{% endif %}{% if item.current %}<strong>{{ item.label }}</strong>{% else %}<a href="{{ item.page }}">{{ item.label }}</a>{% endif %}
    {% endfor %}
  </nav>
  {% endif %}
  <p class="meta">Generated {{ generated_at.strftime('%Y-%m-%d %H:%M') }} &middot; {{ events|length }} event(s)</p>
  <table>
    <thead>
      <tr><th>Date</th><th>Race Name</th><th>Club</th><th>Location</th><th>Format</th></tr>
    </thead>
    <tbody>
      {% for event in events %}
      <tr>
        <td>{{ event.start|date('%b')|upper }} {{ event.start.day }}</td>
        <td>{% if event.pdf_url %}<a href="{{ event.pdf_url }}" target="_blank" rel="noopener">{{ event.summary }}</a>{% else %}{{ event.summary }}{% endif %}</td>
        <td>{{ event.details.club }}</td>
        {# Label: "Venue:" line, else the location field. Map target: "GPS:" line, else the location field. #}
        {% set venue_label = event.details.venue or event.location %}
        {% set map_query = event.details.gps or event.location %}
        <td>{% if map_query %}<a href="https://www.google.com/maps/search/?api=1&query={{ map_query|urlencode }}" target="_blank" rel="noopener">{{ venue_label or map_query }}</a>{% else %}{{ venue_label }}{% endif %}</td>
        <td>{{ event.details.format }}</td>
      </tr>
      {% else %}
      <tr><td colspan="5">No events in this date range.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
